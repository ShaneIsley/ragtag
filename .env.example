# Local settings. Generate the real file from Terraform:
#   cd infra && terraform output -raw local_env > ../.env
# .env is git-ignored. Never commit real values.

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
SEARCH_ENDPOINT=
SEARCH_INDEX=policy-desk-chunks
SEARCH_QUERY_KEY=
SEARCH_ADMIN_KEY=
BEDROCK_REGION=ap-southeast-2
BEDROCK_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0
# Failover drill: true makes Azure OpenAI act unreachable, so Bedrock answers. Local only.
FAILOVER_DRILL=false
FEEDBACK_TABLE=policy-desk-feedback
FEEDBACK_RETENTION_DAYS=90
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_ADMIN_ROLE=PolicyDesk.Admin
PUBLIC_BASE_URL=http://localhost:8001
SESSION_SECRET=
# The release (image tag) /health reports; empty locally.
APP_VERSION=
# Where the ingest job records what each run changed and /status reads its snapshot;
# empty locally, so nothing is sent or read.
EVAL_RECORDS_BUCKET=
# Locally, the snapshot /status shows: make status writes evals/results/status/snapshot.json.
STATUS_SNAPSHOT_FILE=
# Traces: none, console, or otlp to the endpoint below (compose.yaml runs a collector).
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=policy-desk-app-local
