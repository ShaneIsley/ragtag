# Section 3.1: who and what Policy Desk deals with.
...@_shared
direction: right

people: UNSW staff, students\nand researchers {icon: ${i-users}}
reviewer: Reviewer {icon: ${i-user}; class: planned}
operator: Operator {icon: ${i-user}}

pd: Policy Desk {
  style: {
    font-size: 24
    bold: true
    fill: "#EEF0FF"
  }
  width: 260
  height: 140
}

unsw: UNSW public websites\n17 policies and guidance pages {icon: ${i-web}}
oai: Azure OpenAI\nembeddings, answers, evaluation judges {icon: ${i-openai}}
search: Azure AI Search\nthe passage index {icon: ${i-search}}
bedrock: Amazon Bedrock\nthe failover model {icon: ${i-bedrock}}
entra: Microsoft Entra ID {icon: ${i-entra}; class: planned}
email: Alert email {icon: ${i-sns}}

people -> pd: a question, then a cited answer
reviewer -> entra: sign in {class: planned}
entra -> pd: PolicyDesk.Admin role {class: planned}
operator -> pd: Terraform, images, releases
pd -> unsw: weekly fetch
pd -> oai: embed, answer, judge
pd -> search: hybrid search
pd -> bedrock: failover, "try the other model"
pd -> email: alarms and failed evaluation runs
