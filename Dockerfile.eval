# The scheduled evaluation: promptfoo and the gate, run against production by
# EventBridge Scheduler (infra/eval.tf). Adds the eval group (the Azure AI
# Evaluation graders and the Lambda runtime client) and promptfoo on Node. Both
# stages are Debian bookworm, so promptfoo's native modules match the final image.
FROM node:22-bookworm-slim AS promptfoo
WORKDIR /opt/promptfoo
RUN npm install --omit=dev --no-audit --no-fund promptfoo@0.124.1

FROM python:3.12-slim-bookworm AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /srv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-default-groups --group eval --no-install-project

FROM python:3.12-slim-bookworm
RUN useradd --create-home --uid 10001 eval
COPY --from=promptfoo /usr/local/bin/node /usr/local/bin/node
COPY --from=promptfoo /opt/promptfoo /opt/promptfoo
WORKDIR /srv
COPY --from=build /srv/.venv /srv/.venv
COPY app/ app/
COPY prompts/ prompts/
COPY evals/ evals/
# COPY keeps the host's file modes; make the code readable whatever they were.
RUN chmod -R a+rX app prompts evals /opt/promptfoo
# Only /tmp is writable on Lambda: promptfoo keeps its database under HOME, and the
# run's results and record go there before the record is uploaded.
ENV PATH="/srv/.venv/bin:/usr/local/bin:$PATH" PYTHONPATH=/srv PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 HOME=/tmp EVAL_RECORDS_DIR=/tmp/records \
    PROMPTFOO_PYTHON=/srv/.venv/bin/python PROMPTFOO_DISABLE_TELEMETRY=1 \
    PROMPTFOO_DISABLE_UPDATE=1
USER eval
ENTRYPOINT ["python", "-m", "awslambdaric"]
CMD ["evals.lambda_handler.handler"]
