# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

alert_email       = "you@example.com"
github_repository = "your-github-user/ragtag" # the GitHub mirror that runs CI
# As GitHub's OIDC tokens name it: owner@owner_id/name@repository_id. Find the IDs at
# api.github.com/users/<owner> and api.github.com/repos/<owner>/<name> ("id").
# github_oidc_repository = "your-github-user@1234/ragtag@567890"

# The Azure IDs come from the signed-in CLIs, so they aren't set here:
# - subscription: export ARM_SUBSCRIPTION_ID=$(az account show --query id -o tsv)
# - tenant: the Azure CLI's signed-in tenant
# - admin view: whoever runs Terraform. To name others instead, set
#   admin_user_object_ids = ["<object id>", ...]

# Stage 1 (local development): leave empty.
# Stage 2 (hosting): set to the commit SHA of the images you pushed, then apply.
image_tag = ""

# See README, Data residency, before changing these.
# chat_deployment_type      = "GlobalStandard"
# embedding_deployment_type = "Standard"
