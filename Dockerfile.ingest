# The weekly ingest job. Adds the ingest group (PyMuPDF4LLM, MarkItDown, splitters).
# On AWS Lambda the runtime interface client calls ingest.lambda_handler.handler;
# compose.yaml overrides the entrypoint to run `python -m ingest` directly.
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /srv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-default-groups --group ingest --no-install-project

FROM python:3.12-slim
RUN useradd --create-home --uid 10001 ingest
WORKDIR /srv
COPY --from=build /srv/.venv /srv/.venv
COPY app/ app/
COPY ingest/ ingest/
COPY search/index.json search/index.json
# COPY keeps the host's file modes; make the code readable whatever they were.
RUN chmod -R a+rX app ingest search
ENV PATH="/srv/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
USER ingest
ENTRYPOINT ["python", "-m", "awslambdaric"]
CMD ["ingest.lambda_handler.handler"]
